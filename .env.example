# All VITE_ values are public and included in the browser bundle.
VITE_SITE_URL=https://duokimaxis.com
VITE_CONTACT_EMAIL=duokimaxis@gmail.com

# Optional. Leave blank to prepare email drafts in the visitor's email app.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Optional. Analytics stays off unless configured AND the visitor opts in.
VITE_GA_MEASUREMENT_ID=
